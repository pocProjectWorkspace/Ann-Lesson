# Copy to .env.prod and fill in. Never commit .env.prod.
POSTGRES_USER=lessonplan
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=lessonplan

# 32+ random characters, e.g. from: openssl rand -base64 48
AUTH_SECRET=

# Public hostnames the app is served from, comma-separated (for CSRF protection)
APP_ORIGINS=app.example.com

# local = files on the "uploads" volume; s3 = any S3-compatible bucket
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Platform owner account created by the seed on first run
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-before-first-run

WEB_PORT=3000

# Optional: POST a JSON payload here on every server error (Slack/Discord/Teams webhook or your own collector)
ERROR_WEBHOOK_URL=
# Optional: shown in error reports, e.g. a git SHA
APP_VERSION=
# Backups: how many days to keep locally, and an optional S3 destination (needs aws CLI credentials in the container)
BACKUP_KEEP_DAYS=14
BACKUP_S3_URI=

# Origins allowed to call the token API from a browser (mobile web build), comma-separated
CORS_ORIGINS=
# Push notifications through Expo (1 = on). EXPO_ACCESS_TOKEN only if your Expo project needs it.
PUSH_ENABLED=1
EXPO_ACCESS_TOKEN=

# Largest PDF a school may upload, in MB
MAX_UPLOAD_MB=250
