generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

/// One tenant. Every school-scoped row carries schoolId.
model School {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // short code students type at login, e.g. "GREENWOOD"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription
  plan          String    @default("TRIAL") // TRIAL | BASIC | PRO | CUSTOM
  planExpiresAt DateTime? // null = never expires
  maxStudents   Int       @default(50)
  maxTeachers   Int       @default(5)
  maxStorageMb  Int       @default(1024)

  // Sign-in method, set by the platform owner: FORM (school code + password),
  // MICROSOFT (Entra ID / Microsoft 365) or GOOGLE (Google Workspace). Staff of an SSO
  // school sign in with the provider; students keep student ID + password unless
  // ssoStudents is on. The client secret is stored encrypted (see lib/sso.ts).
  authMode         String  @default("FORM")
  ssoTenant        String? // Microsoft: directory (tenant) id. Google: the Workspace domain.
  ssoClientId      String?
  ssoClientSecret  String? // encrypted
  ssoAdminGroups   String? // comma-separated group ids (Microsoft) or emails: who becomes a school admin
  ssoTeacherGroups String? // comma-separated group ids or emails; empty = every staff sign-in becomes a teacher
  ssoAutoProvision Boolean @default(true) // create teachers on first sign-in
  ssoStudents      Boolean @default(false) // students may also sign in with the provider (matched by email)

  // School preference: do students see their position in the class ranking, or only
  // their own stars? Set by the school admin on the overview page.
  showStudentRank Boolean @default(true)

  users    User[]
  classes  Class[]
  subjects Subject[]
  lessons  Lesson[]
  files    LessonFile[]
  invoices Invoice[]
  audits   AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  schoolId     String? // null only for SUPER_ADMIN
  role         Role
  name         String
  username     String // login id; unique within a school
  email        String?
  passwordHash String
  isActive     Boolean  @default(true)
  classId      String? // students: the class they belong to
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // How this person signs in. FORM = local password. MICROSOFT / GOOGLE = linked to the
  // school provider; externalId is the provider subject. A break-glass admin always has a
  // working local password, whatever the school mode, so a provider outage cannot lock
  // the school out.
  authProvider String  @default("FORM")
  externalId   String?
  isBreakGlass Boolean @default(false)

  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class?  @relation("StudentsInClass", fields: [classId], references: [id], onDelete: SetNull)

  teachingAssignments TeacherAssignment[]
  progress            LessonProgress[]
  boardNotes          BoardNote[]
  activitySubmissions ActivitySubmission[]
  readingDays         ReadingDay[]
  stickers            Sticker[]           @relation("StickerOwner")
  stickersGiven       Sticker[]           @relation("StickerGiver")
  narrations          PageAudio[]         @relation("Narrator")
  pageDwell           PageDwell[]
  supportAlerts       SupportAlert[]      @relation("AlertStudent")
  alertsHandled       SupportAlert[]      @relation("AlertHandler")
  colourings          PageColouring[]
  children            GuardianLink[]      @relation("ParentOf")
  guardians           GuardianLink[]      @relation("ChildOf")
  gradesReceived      SubjectGrade[]      @relation("GradedStudent")
  gradesGiven         SubjectGrade[]      @relation("GradedBy")
  sessions            Session[]
  notifications       Notification[]
  pushTokens          PushToken[]
  confirmations       LessonProgress[]    @relation("ConfirmedBy")
  auditActions        AuditLog[]

  @@unique([schoolId, username])
  @@index([schoolId, role])
  @@index([schoolId, externalId])
}

/// One row per signed-in device. Lets us revoke access immediately.
model Session {
  id         String    @id @default(uuid())
  userId     String
  kind       String    @default("web") // "web" | "mobile"
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Class {
  id           String   @id @default(uuid())
  schoolId     String
  name         String // e.g. "Grade 5"
  section      String? // e.g. "A"
  academicYear String? // e.g. "2026-27"
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects Subject[]
  students User[]              @relation("StudentsInClass")
  teachers TeacherAssignment[]

  @@index([schoolId])
}

model Subject {
  id        String   @id @default(uuid())
  schoolId  String
  classId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  grades   SubjectGrade[]

  @@index([classId])
}

model Lesson {
  id          String    @id @default(uuid())
  schoolId    String
  subjectId   String
  title       String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  // Null = draft: visible to school admins and teachers only. Set when the admin publishes,
  // which is also when students are notified.
  publishedAt DateTime?

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject  Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  files    LessonFile[]
  progress LessonProgress[]
  pageDwell     PageDwell[]
  supportAlerts SupportAlert[]
  colourings    PageColouring[]

  @@index([subjectId])
}

model LessonFile {
  id         String   @id @default(uuid())
  schoolId   String
  lessonId   String
  fileName   String
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  boardNotes BoardNote[]
  narrations PageAudio[]
  colourings PageColouring[]

  @@index([lessonId])
}

model TeacherAssignment {
  id        String @id @default(uuid())
  teacherId String
  classId   String

  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
}

model LessonProgress {
  id            String    @id @default(uuid())
  studentId     String
  lessonId      String
  firstViewedAt DateTime  @default(now())
  lastViewedAt  DateTime  @default(now())
  learntAt      DateTime?
  confirmedAt   DateTime? // teacher confirmed the student has learnt it
  confirmedById String?
  // Reading position, reported by the book viewer: the page the student is on, the
  // furthest page reached, how many pages the book has, and when the end was reached.
  lastPage      Int       @default(0)
  maxPage       Int       @default(0)
  pageCount     Int?
  finishedAt    DateTime?

  student     User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  confirmedBy User?  @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([studentId, lessonId])
}

/// In-app notification for one user.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String?
  href      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Who did what, for platform and school admins.
model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String? // null for platform-level actions
  actorId    String?
  actorName  String
  action     String // e.g. "student.create"
  targetType String? // e.g. "User"
  targetId   String?
  summary    String // human-readable one line
  meta       Json?
  createdAt  DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([createdAt])
}

/// Manual invoice raised by the platform owner against a school.
model Invoice {
  id          String    @id @default(uuid())
  schoolId    String
  number      String    @unique
  description String
  amountCents Int
  currency    String    @default("INR")
  issuedAt    DateTime  @default(now())
  dueAt       DateTime
  paidAt      DateTime?
  note        String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, issuedAt])
}

/// Expo push token for one device of one user.
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String? // ios | android | web
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A teacher's rating of a student in one subject, 1 (needs support) to 5 (excellent).
/// One row per student and subject; saving again overwrites it. Overall grade and class
/// ranking are computed from these (see lib/grades.ts).
model SubjectGrade {
  id        String   @id @default(uuid())
  schoolId  String
  subjectId String
  studentId String
  teacherId String?
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student User    @relation("GradedStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User?   @relation("GradedBy", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([subjectId, studentId])
  @@index([schoolId, studentId])
}

/// What a teacher drew on one page of a book in smart board mode. Strokes are stored in
/// page-relative coordinates (0..1) so they fit any screen. One row per teacher, file and page.
model BoardNote {
  id        String   @id @default(uuid())
  schoolId  String
  fileId    String
  teacherId String
  page      Int
  strokes   Json
  updatedAt DateTime @updatedAt

  file    LessonFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  teacher User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([fileId, page, teacherId])
  @@index([fileId, teacherId])
}

/// The live classroom session of one class: what the board is showing and whether
/// students follow it. One row per class; cleared when the teacher closes the board.
/// Fan-out to connected devices is in memory (lib/live.ts); this row is the source of
/// truth a device reads when it connects.
model LiveSession {
  id        String   @id @default(uuid())
  schoolId  String
  classId   String   @unique
  teacherId String
  lessonId  String
  fileId    String
  page      Int      @default(1)
  follow    Boolean  @default(false)
  activityId String? // the activity currently on the students' desks, if any
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([schoolId])
}

/// Board-to-desk: a page the teacher sent to the class as an activity. Children draw on
/// it on their devices; their strokes come back as submissions and show on the board.
model Activity {
  id        String    @id @default(uuid())
  schoolId  String
  classId   String
  lessonId  String
  fileId    String
  page      Int
  prompt    String?
  teacherId String
  status    String    @default("OPEN") // OPEN | CLOSED
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  submissions ActivitySubmission[]

  @@index([classId, createdAt])
}

model ActivitySubmission {
  id          String    @id @default(uuid())
  activityId  String
  studentId   String
  strokes     Json
  done        Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentId])
}

// One row per student per calendar day with any reading; the streak is the run of
// consecutive days. "day" is YYYY-MM-DD in the child's own time zone.
model ReadingDay {
  id        String @id @default(uuid())
  studentId String
  day       String
  pages     Int    @default(0)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, day])
}

// A badge the platform awarded (givenById null, earnKey "studentId:kind" so it is
// awarded once) or a sticker a teacher gave (givenById set, any number of times).
model Sticker {
  id        String   @id @default(uuid())
  schoolId  String
  studentId String
  kind      String
  note      String?
  givenById String?
  lessonId  String?
  earnKey   String?  @unique
  createdAt DateTime @default(now())

  student User  @relation("StickerOwner", fields: [studentId], references: [id], onDelete: Cascade)
  givenBy User? @relation("StickerGiver", fields: [givenById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([schoolId])
}

// Read-to-me: a teacher's voice clip for one page of a book, stored next to the PDFs.
model PageAudio {
  id         String   @id @default(uuid())
  schoolId   String
  lessonId   String
  fileId     String
  page       Int
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  durationMs Int?
  teacherId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  file    LessonFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  teacher User?      @relation("Narrator", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([fileId, page])
  @@index([schoolId])
}

// Page attention: how long a child had each page of a book on screen, summed over visits.
model PageDwell {
  id        String   @id @default(uuid())
  studentId String
  lessonId  String
  page      Int
  ms        Int      @default(0)
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId, page])
  @@index([lessonId, page])
}

// Early-support alert for a teacher: open while the signal holds, closed when it clears
// or the teacher marks it handled (handledById set).
model SupportAlert {
  id          String    @id @default(uuid())
  schoolId    String
  classId     String
  studentId   String
  kind        String // quiet | stuck | behind | slow-page
  lessonId    String?
  page        Int?
  detail      String
  action      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  handledById String?

  student   User    @relation("AlertStudent", fields: [studentId], references: [id], onDelete: Cascade)
  handledBy User?   @relation("AlertHandler", fields: [handledById], references: [id], onDelete: SetNull)
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([classId, resolvedAt])
  @@index([schoolId])
}

// A parent (role PARENT) linked to a child (role STUDENT) in the same school.
model GuardianLink {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  relation  String?
  createdAt DateTime @default(now())

  parent  User @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("ChildOf", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

// A child's colouring of one page of a book: crayon strokes and fills, page-relative.
model PageColouring {
  id        String   @id @default(uuid())
  studentId String
  lessonId  String
  fileId    String
  page      Int
  strokes   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file    LessonFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([studentId, fileId, page])
  @@index([lessonId, updatedAt])
}
